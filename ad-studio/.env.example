# --- Meta / Facebook App credentials ---
# Create an app at https://developers.facebook.com/apps -> add the "Marketing API" product.
FB_APP_ID=
FB_APP_SECRET=
# Must exactly match a "Valid OAuth Redirect URI" configured on your Facebook App
# (Facebook Login for Business -> Settings). For local dev this is usually:
# http://localhost:3000/api/auth/facebook/callback
FB_REDIRECT_URI=http://localhost:3000/api/auth/facebook/callback
FB_GRAPH_VERSION=v21.0

# Optional: skip the OAuth dance entirely by pasting a long-lived System User
# access token generated in Meta Business Suite -> Business Settings -> System Users.
# This is the recommended way to run this as an unattended automation for YOUR
# OWN ad account (see GUIDE.md, Option B). If set, the Connect step becomes a no-op.
FB_SYSTEM_USER_TOKEN=

# Public URL this app is served from (used to build the OAuth redirect + absolute
# image URLs Facebook needs when fetching your creative assets).
NEXT_PUBLIC_APP_URL=http://localhost:3000
